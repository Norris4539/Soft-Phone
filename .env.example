# ---------------------------------------------------------------------------
# Soft-Phone switchboard — environment configuration
# Copy to .env and fill in.  Never commit .env.
# ---------------------------------------------------------------------------

# --- Public identity -------------------------------------------------------
# Hostname clients reach.  Must match the CN/SAN on your TLS certificate,
# because browsers refuse WSS to a cert that does not match.
PUBLIC_HOSTNAME=localhost

# The company's main number (DID) as your trunk provider delivers it.
# Digits only, E.164 without the leading '+'.  Used for inbound matching and
# as the default outbound caller ID.
MAIN_DID=15551234567
MAIN_CALLER_ID_NAME=Acme Inc

# --- Switchboard behaviour --------------------------------------------------
# Extension that acts as the operator: takes '0', unanswered ring groups, and
# owns the company voicemail box.  Must exist in config/users.json.
OPERATOR_EXTENSION=100

# The IVR ("press 1 for sales...") needs recorded prompts.  Leave false to send
# inbound calls straight to the reception ring group, which needs none.
# Record prompts with ./scripts/generate-prompts.sh, then set this to true.
IVR_ENABLED=false

# When the office is open, in Asterisk GotoIfTime syntax:
#   <time range>,<days of week>,<days of month>,<months>
# Outside these hours the main line goes to the company mailbox.
# '*,*,*,*' means always open.
OFFICE_HOURS=09:00-17:00,mon-fri,*,*

# --- SIP trunk (your provider) ---------------------------------------------
# Works with Telnyx, Twilio Elastic SIP Trunking, Bandwidth, Flowroute, etc.
# TRUNK_AUTH=userpass  -> register + digest auth with TRUNK_USERNAME/PASSWORD
# TRUNK_AUTH=ip        -> IP-authenticated trunk, no registration
TRUNK_ENABLED=false
TRUNK_AUTH=userpass
TRUNK_NAME=primary
TRUNK_HOST=sip.example-provider.com
TRUNK_PORT=5060
TRUNK_TRANSPORT=udp
TRUNK_USERNAME=changeme
TRUNK_PASSWORD=changeme
# Some providers require a distinct auth username / from-domain.
TRUNK_FROM_USER=
TRUNK_FROM_DOMAIN=

# --- Asterisk --------------------------------------------------------------
ASTERISK_SIP_DOMAIN=localhost
# ARI (Asterisk REST Interface) — used by the control server for live state.
ARI_USERNAME=switchboard
ARI_PASSWORD=change-this-ari-password
ARI_APP=switchboard
# AMI is enabled for queue/dialplan operations ARI does not expose.
AMI_USERNAME=switchboard
AMI_PASSWORD=change-this-ami-password

# RTP port range published by the Asterisk container.
RTP_START=10000
RTP_END=10200

# --- coturn (STUN/TURN) ----------------------------------------------------
TURN_REALM=softphone.local
TURN_USERNAME=softphone
TURN_PASSWORD=change-this-turn-password
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Set to the server's public IP when deploying behind NAT; blank for local dev.
TURN_EXTERNAL_IP=

# --- Control server --------------------------------------------------------
SERVER_PORT=4000
# Sign JWTs.  Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_TTL=12h

# --- Web app ---------------------------------------------------------------
WEB_PORT=8080
